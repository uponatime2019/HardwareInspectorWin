<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NewHwInspector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="New HwInspector">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource TitleBarBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="14,0,8,0">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE950;" Foreground="{ThemeResource AccentCyanBrush}"/>
                <TextBlock Text="New HwInspector" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="— hardware diagnostics &amp; monitoring" FontSize="14" Foreground="{ThemeResource SubTextBrush}" VerticalAlignment="Center"/>
                <Border x:Name="AlertBadge" Visibility="Collapsed" Background="{ThemeResource AccentRedBrush}" CornerRadius="10" Padding="6,2" Margin="6,0,0,0">
                    <TextBlock x:Name="AlertBadgeText" FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button x:Name="RefreshBtn" Click="OnGlobalRefresh" ToolTipService.ToolTip="Refresh overview &amp; hardware (Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock Text="Refresh" FontSize="14"/>
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="ExportBtn" Click="OnGlobalExport" ToolTipService.ToolTip="Export report">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                        <TextBlock Text="Export" FontSize="14"/>
                    </StackPanel>
                </Button>
                <DropDownButton ToolTipService.ToolTip="Theme">
                    <FontIcon Glyph="&#xE793;" FontSize="13"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="Dark" GroupName="Theme" Click="OnThemeDark"/>
                            <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="Light" GroupName="Theme" Click="OnThemeLight"/>
                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="System" GroupName="Theme" Click="OnThemeSystem"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="190"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{ThemeResource NavBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView x:Name="NavList" Grid.Row="0" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavItemClick" Margin="6,8,6,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="38"/>
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="{Binding Glyph}" Foreground="{Binding IconBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="{Binding BadgeBrush}" CornerRadius="8" Padding="5,1" Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="1" Margin="8,4,8,8" Padding="10,8" CornerRadius="6" Background="{ThemeResource ChipBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Monitoring" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CardTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="MonitorDot" Width="8" Height="8" Fill="{ThemeResource AccentGreenBrush}"/>
                            <TextBlock x:Name="MonitorStateText" FontSize="14" Foreground="{ThemeResource SubTextBrush}" Text="Active"/>
                        </StackPanel>
                        <TextBlock x:Name="MonitorDetailText" FontSize="14" Foreground="{ThemeResource SubTextBrush}" Text="—" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="NavPauseBtn" FontSize="14" Padding="8,4" Click="OnNavPause">Pause</Button>
                            <Button FontSize="14" Padding="8,4" Click="OnNavRefreshSensors">Refresh</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{ThemeResource DividerBrush}"/>

            <Frame x:Name="ContentFrame" Grid.Column="2" Background="{ThemeResource AppBgBrush}"/>

            <Grid x:Name="StartupLoadingOverlay" Grid.Column="2" Background="{ThemeResource AppBgBrush}">
                <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <TextBlock Text="New HwInspector" Style="{ThemeResource HeaderTextStyle}" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StartupProgressText" Text="Preparing hardware scan…" Style="{ThemeResource SubText}" FontSize="14" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="StartupProgressBar" Minimum="0" Maximum="100" Value="0" Height="8"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{ThemeResource TitleBarBgBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText" Grid.Column="0" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource SubTextBrush}" Text="New HwInspector v1.0.0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource SubTextBrush}" TextTrimming="CharacterEllipsis" Text="Ready — local-only, no network."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE77B;" Foreground="{ThemeResource SubTextBrush}"/>
                    <TextBlock x:Name="UptimeText" FontSize="14" Foreground="{ThemeResource SubTextBrush}" Text="Uptime —"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
