<UserControl
    x:Class="NewHwInspector.Views.ChartsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource TitleBarBgBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Charts" Style="{ThemeResource HeaderTextStyle}" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox x:Name="SensorCombo" Grid.Column="1" PlaceholderText="Select sensor" SelectionChanged="OnSensorChanged" DisplayMemberPath="Name"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Range:" VerticalAlignment="Center" Style="{ThemeResource SubText}"/>
                    <ComboBox x:Name="RangeCombo" Width="110" SelectionChanged="OnRangeChanged">
                        <ComboBoxItem Content="1 min" Tag="1"/>
                        <ComboBoxItem Content="5 min" Tag="5" IsSelected="True"/>
                        <ComboBoxItem Content="15 min" Tag="15"/>
                        <ComboBoxItem Content="30 min" Tag="30"/>
                    </ComboBox>
                    <CheckBox x:Name="AutoFitCheck" Content="Auto-fit" IsChecked="True" Checked="OnAutoFitChanged" Unchecked="OnAutoFitChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                    <Button Click="OnClear" ToolTipService.ToolTip="Clear history">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                            <TextBlock Text="Clear"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnExportChart" ToolTipService.ToolTip="Export chart data">
                        <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chart area -->
        <Grid Grid.Row="1" Background="{ThemeResource AppBgBrush}" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Stats header -->
            <Border Style="{ThemeResource CardBorder}" Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ChartTitle" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CardTextBrush}"/>
                        <TextBlock x:Name="ChartSubtitle" Style="{ThemeResource SubText}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" MinWidth="80">
                        <TextBlock Text="Current" Style="{ThemeResource SubText}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CurText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" MinWidth="80">
                        <TextBlock Text="Min" Style="{ThemeResource SubText}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MinText" FontSize="14" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2" MinWidth="80">
                        <TextBlock Text="Max" Style="{ThemeResource SubText}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MaxText" FontSize="14" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="2" MinWidth="80">
                        <TextBlock Text="Average" Style="{ThemeResource SubText}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AvgText" FontSize="14" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Canvas chart -->
            <Border Grid.Row="1" Style="{ThemeResource CardBorder}" Padding="0">
                <Grid>
                    <Canvas x:Name="ChartCanvas" Background="Transparent" SizeChanged="OnCanvasSizeChanged"/>
                    <TextBlock x:Name="EmptyText" Text="Select a sensor to view its history chart. History is collected every refresh interval." Style="{ThemeResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
                </Grid>
            </Border>

            <!-- X axis labels -->
            <Grid Grid.Row="2" Margin="0,6,0,0" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftTime" Style="{ThemeResource SubText}" FontSize="14"/>
                <TextBlock Grid.Column="1" x:Name="CenterTime" Style="{ThemeResource SubText}" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="RightTime" Style="{ThemeResource SubText}" FontSize="14" HorizontalAlignment="Right" Text="Now"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource TitleBarBgBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" Style="{ThemeResource SubText}" Text="Chart shows sensor history. Auto-fit scales Y to data range."/>
        </Border>
    </Grid>
</UserControl>
