<UserControl
    x:Class="NewHwInspector.Views.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="260"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tree -->
        <Grid Grid.Column="0" Background="{ThemeResource NavBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="12,12,12,8" Spacing="8">
                <TextBlock Text="Hardware Tree" Style="{ThemeResource HeaderTextStyle}" FontSize="14"/>
                <TextBox x:Name="SearchBox" PlaceholderText="Filter hardware..." TextChanged="OnSearchChanged"/>
                <TextBlock Style="{ThemeResource SubText}" Text="Select a node to view its properties on the right." TextWrapping="Wrap"/>
            </StackPanel>
            <TreeView x:Name="HwTree" Grid.Row="1" Margin="4,0,4,8" SelectionMode="Single" ItemInvoked="OnTreeInvoked" Expanding="OnExpanding">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{Binding Icon}" FontSize="13" Foreground="{ThemeResource SubTextBrush}"/>
                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                <TextBlock Text="{Binding Summary}" Style="{ThemeResource SubText}" FontSize="14" Opacity="0.8"/>
                            </StackPanel>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <Border Grid.Row="2" Margin="8" Padding="10" CornerRadius="6" Background="{ThemeResource ChipBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TreeCountText" Style="{ThemeResource SubText}" FontSize="14" Text="—"/>
                    <Button Content="Expand all" Click="OnExpandAll" FontSize="14" Padding="8,4"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{ThemeResource DividerBrush}"/>

        <!-- Detail -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel Spacing="12" x:Name="DetailPanel">
                <Border Style="{ThemeResource CardBorder}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="DetailIcon" Glyph="&#xE770;" FontSize="18" Foreground="{ThemeResource AccentCyanBrush}"/>
                            <TextBlock x:Name="DetailTitle" Style="{ThemeResource HeaderTextStyle}" FontSize="15" Text="Select a component"/>
                        </StackPanel>
                        <TextBlock x:Name="DetailSummary" Style="{ThemeResource SubText}"/>
                            <TextBlock x:Name="DetailType" Style="{ThemeResource SubText}" FontSize="14"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PropertiesCard" Style="{ThemeResource CardBorder}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Properties" Style="{ThemeResource CardTitleText}"/>
                        <StackPanel x:Name="PropsStack" Spacing="6"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ChildrenCard" Style="{ThemeResource CardBorder}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Child devices" Style="{ThemeResource CardTitleText}"/>
                        <StackPanel x:Name="ChildrenStack" Spacing="4"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnCopy" ToolTipService.ToolTip="Copy details">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnRefreshHw" ToolTipService.ToolTip="Refresh hardware data">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <InfoBar x:Name="InfoBar" IsOpen="False" Severity="Informational" IsClosable="True" Title="Hardware data" Message="All values gathered locally via WMI. '—' means not exposed by firmware."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
