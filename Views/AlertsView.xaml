<UserControl
    x:Class="NewHwInspector.Views.AlertsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource TitleBarBgBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="Alerts" Style="{ThemeResource HeaderTextStyle}" FontSize="14"/>
                    <TextBlock Style="{ThemeResource SubText}" Text="Configure thresholds for supported sensors. Active alerts turn red and are shown at the top. Alerts are evaluated every refresh interval." TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnAddAlert">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="New threshold"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnClearAll">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                            <TextBlock Text="Clear all"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active alerts banner -->
        <InfoBar x:Name="ActiveBar" Grid.Row="0" VerticalAlignment="Bottom" Margin="12,0,12,0" IsOpen="False" Severity="Error" Title="Active alerts" IsClosable="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel Spacing="12">
                <Border x:Name="EmptyCard" Style="{ThemeResource CardBorder}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="16">
                        <FontIcon Glyph="&#xE7BA;" FontSize="24" Foreground="{ThemeResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No alert rules yet" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource CardTextBrush}"/>
                        <TextBlock Text="Click 'New threshold' to monitor a sensor. Example: alert when CPU temperature goes above 85 °C." Style="{ThemeResource SubText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="RulesHost" Spacing="10"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{ThemeResource TitleBarBgBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" Style="{ThemeResource SubText}" Text="0 rules • 0 active"/>
        </Border>

        <!-- Dialog host for new alert -->
        <ContentDialog x:Name="AlertDialog" Title="Configure alert" PrimaryButtonText="Save" CloseButtonText="Cancel" DefaultButton="Primary">
            <StackPanel Spacing="12" Width="380">
                <ComboBox x:Name="SensorPicker" Header="Sensor" PlaceholderText="Select sensor" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                <ComboBox x:Name="ConditionPicker" Header="Condition" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="Above (≥ threshold)" Tag="Above"/>
                    <ComboBoxItem Content="Below (≤ threshold)" Tag="Below"/>
                </ComboBox>
                <NumberBox x:Name="ThresholdBox" Header="Threshold value" SpinButtonPlacementMode="Inline" Minimum="-9999" Maximum="99999" Value="80"/>
                <TextBlock x:Name="UnitText" Style="{ThemeResource SubText}" FontSize="14"/>
                <CheckBox x:Name="EnabledCheck" Content="Enabled" IsChecked="True"/>
                <TextBlock Style="{ThemeResource SubText}" FontSize="14" TextWrapping="Wrap" Text="Tip: CPU temperature warning at 80–85 °C and critical at 90 °C. Memory usage warning at 85%+."/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>
